{
  // Static site served by Cloudflare Workers (static assets only, no server code).
  // The site's files are in public/. Push to main and Cloudflare deploys it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-orangery",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
